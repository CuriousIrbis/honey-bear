{
    "compilerOptions": {
        "target": "esnext",                     // указывает под какую версию JS проверять и компилировать код
        "module": "nodenext",                   // включает алгоритм разрешения модулей
        "rewriteRelativeImportExtensions": true,// разрешает писать пути к файлам через .ts, а при компиляции автоматически меняет на .js
        "erasableSyntaxOnly": true,             // запрещает использовать особенности TS, которые при компиляции превращаются в реальный JS-код
        "verbatimModuleSyntax": true,           // заставляет компилятор оставлять импорты и экспорты в том виде, в каком они использовались, без скрытых оптимизаций
        "noEmit": true,                         // запрещает TS создавать файлы на диске: никаких .d.ts и .js на выходе
        "strict": true,                         // включает строгий режим проверки типов
        "skipLibCheck": true                    // пропускает проверку типов внутри файлов-деклараций .d.ts
    },
    "include":[
        "/src/**/*"
    ]
}